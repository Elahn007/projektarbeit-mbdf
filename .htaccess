RewriteEngine On

# Permanent redirect from old URL containing "ß" to ASCII-safe URL
RewriteRule ^wasserschlo%C3%9F\.html$ /Orte/wasserschloss.html [R=301,L,NE]
RewriteRule ^wasserschloß\.html$ /Orte/wasserschloss.html [R=301,L,NE]

# Redirect old root-level place pages to the Orte folder
RewriteRule ^(alte_teppichfabrik|feuerwehr|heimatmuseum|kirche|kletterwald|naturbad|rathaus|seliger|wasserschloss)\.html$ /Orte/$1.html [R=301,L]

# Optional clean language path
RewriteRule ^en/?$ /en/index.html [R=301,L]

ErrorDocument 404 /404.html

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/manifest+json "access plus 7 days"
    ExpiresByType application/json "access plus 1 day"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresDefault "access plus 7 days"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <FilesMatch "\.(jpg|jpeg|png|webp|avif|svg)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    <Files "service-worker.js">
        Header set Cache-Control "no-cache"
    </Files>
</IfModule>


